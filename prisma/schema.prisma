generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Listing {
  id           String   @id @default(cuid())
  vertical     String   // "india" | "global"
  title        String
  description  String
  price        Int
  currency     String   @default("INR") // INR | USD | AED | EUR | GBP
  state        String
  city         String
  propertyType String   // flat | plot | house | commercial | villa
  bhk          Int?
  areaSqFt     Int
  images       String[] // array of image URLs
  status       String   @default("active") // active | inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Submission {
  id           String   @id @default(cuid())
  vertical     String
  name         String
  phone        String
  email        String?
  state        String
  city         String
  propertyType String
  price        Int
  currency     String   @default("INR")
  bhk          Int?
  areaSqFt     Int
  description  String
  images       String[]
  status       String   @default("pending") // pending | approved | rejected
  rejectReason String?
  createdAt    DateTime @default(now())
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String // hashed
}

model Reel {
  id           String   @id @default(cuid())
  vertical     String   // "india" | "global"
  title        String
  videoUrl     String   // MP4 URL or Instagram Reel URL/Embed code
  instagramUrl String?
  thumbnail    String?
  views        String   @default("10K+ views")
  tag          String   @default("Featured")
  createdAt    DateTime @default(now())
}
